<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0D1119">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AMPYCANON"
            android:textColor="#78D6EB"
            android:textSize="13sp"
            android:letterSpacing="0.22"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Print Bridge"
            android:textColor="#FFFFFF"
            android:textSize="29sp"
            android:layout_marginTop="3dp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="EOS R6 Mark II  ·  CCAPI  ·  Rev2"
            android:textColor="#9FB0C5"
            android:layout_marginTop="6dp"
            android:textSize="13sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="19dp"
            android:padding="14dp"
            android:background="@drawable/panel">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="01 · CONNESSIONE CANON"
                android:textColor="#DAE4F2"
                android:textStyle="bold"
                android:textSize="13sp" />
            <EditText
                android:id="@+id/address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:singleLine="true"
                android:inputType="textUri"
                android:selectAllOnFocus="true"
                android:hint="http://192.168.1.2:8080"
                android:textColor="#FFFFFF"
                android:textColorHint="#879BB0"
                android:textSize="15sp" />
            <EditText
                android:id="@+id/username"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Utente CCAPI (facoltativo)"
                android:singleLine="true"
                android:inputType="text"
                android:textColor="#FFFFFF"
                android:textColorHint="#879BB0" />
            <EditText
                android:id="@+id/password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Password CCAPI (facoltativa)"
                android:inputType="textPassword"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#879BB0" />
            <Button
                android:id="@+id/connect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="CONNETTI ALLA CANON" />
            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Non connessa"
                android:textColor="#B0C0D5"
                android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:padding="14dp"
            android:background="@drawable/panel">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="02 · JPEG + RAW CR3"
                android:textStyle="bold"
                android:textColor="#DAE4F2"
                android:textSize="13sp" />
            <Button
                android:id="@+id/load"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="CERCA FOTO SU ENTRAMBE LE SD" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/filterAll"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="TUTTI" />
                <Button
                    android:id="@+id/filterJpg"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="JPEG" />
                <Button
                    android:id="@+id/filterRaw"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="RAW" />
            </LinearLayout>
            <Button
                android:id="@+id/importLocal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="IMPORTA RAW / JPEG DAL TELEFONO" />
            <ListView
                android:id="@+id/files"
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:layout_marginTop="8dp"
                android:divider="#304052"
                android:dividerHeight="1dp"
                android:choiceMode="singleChoice" />
            <TextView
                android:id="@+id/selectedName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Tocca una foto nell’elenco"
                android:textColor="#9FB0C5"
                android:textSize="12sp" />
            <ImageView
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="235dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/preview_background"
                android:contentDescription="Anteprima fotografia selezionata"
                android:scaleType="fitCenter" />
            <Button
                android:id="@+id/download"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="SALVA ORIGINALE JPEG / RAW" />
            <Button
                android:id="@+id/openRawEditor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="APRI EDITOR RAW" />
            <Button
                android:id="@+id/chooseRawEditor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SCEGLI APP EDITOR RAW" />
            <Button
                android:id="@+id/rawToJpeg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ESPORTA ANTEPRIMA RAW IN JPEG PER KODAK" />
            <Button
                android:id="@+id/share"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CONDIVIDI FOTO / KODAK" />
            <Button
                android:id="@+id/openKodak"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="APRI APP KODAK PHOTO PRINTER" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:text="NOTA · I file RAW vengono copiati senza modifiche, non convertiti in JPEG. La stampante Kodak richiede la propria app. Il collegamento Bluetooth diretto non è ancora incluso. Nessun file è installato nella fotocamera."
            android:textColor="#8EA2BA"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="#91BED0"
            android:textIsSelectable="true"
            android:textSize="11sp"
            android:paddingBottom="24dp" />
    </LinearLayout>
</ScrollView>
